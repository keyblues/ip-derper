{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "pinDigests": false,
  "packageRules": [
    {
      "description": "Actions 固定到 commit SHA，防 tag 被移动",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "大版本升级不自动开 PR，先看 CHANGELOG",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "description": "TAILSCALE_VERSION 由 .github/workflows/build.yml 每日检测后自动回写，这里只做提示不开 PR",
      "customType": "regex",
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": ["ARG TAILSCALE_VERSION=(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "tailscale/tailscale",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "enabled": false
    }
  ]
}
