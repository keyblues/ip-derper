# 复制成 .env 后按需修改：cp .env.example .env

# ---- 必填 ----
# 公网 IPv4（纯 IP 模式），或已解析到本机的域名
DERP_HOST=1.2.3.4

# ---- 镜像 ----
DERP_IMAGE=ghcr.io/keyblues/ip-derper:latest

# ---- 端口 ----
# 宿主 DERP 端口（客户端 DERPPort 必须与它一致）
DERP_PORT=443
# 宿主 STUN 端口（客户端 STUNPort 必须与它一致）
STUN_PORT=3478

# ---- ACL 片段生成用（可留默认） ----
# 900-998 是 Tailscale 保留给自定义 DERP 的区间
DERP_REGION_ID=900
DERP_REGION_CODE=cn
DERP_NODE_NAME=derp-1

# ---- 安全 ----
# true = 只有你 tailnet 内的设备能用这个中继（需在宿主机装 tailscale 并登录，
#        且 docker-compose.yml 里取消 tailscaled.sock 挂载的注释）
# false = 任何人都能当中继用，会烧你的流量
DERP_VERIFY_CLIENTS=false

# ---- 证书 ----
# 自签证书有效期（天）。默认 10 年。
# 换了这个值不会自动重签 —— 删掉 data/certs 才会重签，那会改变 CertName 指纹。
DERP_CERT_DAYS=3650
