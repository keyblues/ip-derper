# 必填与否看注释；复制成 .env 后按需修改：cp .env.example .env

# ---- 地址 ----
# auto = 容器启动时自动探测公网 IPv4。
# 需要固定时填公网 IP 或域名（出口 IP ≠ 入口 IP 的场景必须显式写）。
DERP_HOST=auto

# ---- 镜像 ----
DERP_IMAGE=ghcr.io/keyblues/ip-derper:latest

# ---- 端口 ----
# 宿主 DERP 端口，客户端 ACL 里的 DERPPort 必须与它一致
DERP_PORT=443
# 宿主 STUN 端口，客户端 ACL 里的 STUNPort 必须与它一致
STUN_PORT=3478

# ---- ACL 片段生成 ----
# 900-998 是 Tailscale 保留给自定义 DERP 的区间。
# 同一 tailnet 里多台 derper 必须用不同的 ID。
DERP_REGION_ID=900
DERP_REGION_CODE=cn
DERP_NODE_NAME=derp-1

# ---- 防白嫖 ----
# true  = 只有你 tailnet 内的设备能用这个中继（默认）
#         需要宿主机装好 tailscale 并登录，且把 /var/run/tailscale 挂进容器
#         ⚠️ fail-closed：读不到 tailscaled 会拒绝【所有】客户端，中继等于死的
# false = 任何人的 tailnet 都能拿来当中继，会烧你的流量
DERP_VERIFY_CLIENTS=true

# ---- 证书 ----
# 自签证书有效期（天），默认 10 年。
# 改这个值不会触发重签 —— 删掉 data/certs 才会重签，而指纹一变 ACL 就得同步改。
DERP_CERT_DAYS=3650
